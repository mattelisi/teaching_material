# 2. Make a simple plot of point estimates + 95% error bars
ggplot(posterior_ratios, aes(x = group, y = m)) +
geom_point() +
geom_errorbar(aes(ymin = l, ymax = u), width = 0.1) +
labs(
x = NULL,
y = "Ratio relative to White",
title = "Posterior Ratios of Stop Rates vs. White",
caption = "Points = posterior means; bars = 95% credible intervals"
)
