everything(),
names_pattern = "(.*)_vs_white_(.)",  # parse group + statistic
names_to = c("ethnicity", "stat"),
values_to = "value"
) %>%
pivot_wider(names_from = stat, values_from = value) %>%
mutate(
group = case_when(
ethnicity == "black" ~ "Black vs White",
ethnicity == "hisp"  ~ "Hisp vs White"
)
)
