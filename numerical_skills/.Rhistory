# ---- 2-layer neural net figure (ggplot2) ----
library(ggplot2)
# Parameters ---------------------------------------------------------------
n_inputs  <- 5       # show X1, X2, X3, ..., Xn (n_inputs>=5 looks best)
n_outputs <- 5       # show Y1, Y2, Y3, ..., Ym
hi_j      <- 2       # highlighted output index (Y_2)
col_all   <- "grey75"  # color for all (non-highlight) items
col_hi    <- "black"   # highlight color
stroke    <- 1.2       # circle stroke width
# Layout (coordinates) -----------------------------------------------------
# We'll place inputs at x=0, outputs at x=1, top-to-bottom.
y_inputs  <- seq(1, 0, length.out = n_inputs)
y_outputs <- seq(1, 0, length.out = n_outputs)
nodes_in  <- data.frame(x = 0, y = y_inputs, lab = paste0("X", seq_len(n_inputs)))
nodes_out <- data.frame(x = 1, y = y_outputs, lab = paste0("Y", seq_len(n_outputs)))
y_hi      <- nodes_out$y[hi_j]
# All connections (fully connected)
edges <- expand.grid(i = seq_len(n_inputs), j = seq_len(n_outputs))
edges <- transform(
edges,
x0 = 0, y0 = y_inputs[i],
x1 = 1, y1 = y_outputs[j],
hi = (j == hi_j)                 # mark those that go into Y_2
)
# Labels for highlighted edges W_{i2}
w_labs <- subset(edges, hi)[, c("x0","y0","x1","y1","i")]
w_labs$xm <- (w_labs$x0 + w_labs$x1) / 2
w_labs$ym <- (w_labs$y0 + w_labs$y1) / 2
w_labs$lab <- paste0("W[", w_labs$i, hi_j, "]")  # like W[12], W[22], ...
# Plot ---------------------------------------------------------------------
ggplot() +
# (1) All edges in light gray
geom_segment(
data = edges,
aes(x = x0, y = y0, xend = x1, yend = y1),
linewidth = 0.8, color = col_all, lineend = "round"
) +
# (2) Highlighted incoming edges to Y_2
geom_segment(
data = subset(edges, hi),
aes(x = x0, y = y0, xend = x1, yend = y1),
linewidth = 1.2, color = col_hi, lineend = "round"
) +
# (3) Input nodes (white circles with black outline)
geom_point(
data = nodes_in,
aes(x = x, y = y),
shape = 21, size = 9, stroke = stroke, fill = "white", color = col_hi
) +
# (4) Output nodes (default grey)
geom_point(
data = nodes_out,
aes(x = x, y = y),
shape = 21, size = 9, stroke = stroke, fill = "white", color = col_all
) +
# (5) Highlight Y_2 node by overdrawing in black
geom_point(
data = nodes_out[hi_j, ],
aes(x = x, y = y),
shape = 21, size = 9, stroke = stroke, fill = "white", color = col_hi
) +
# (6) Text inside nodes
geom_text(
data = nodes_in,
aes(x = x, y = y, label = lab),
size = 3.8, fontface = "bold"
) +
geom_text(
data = transform(nodes_out, col = ifelse(seq_len(n_outputs)==hi_j, col_hi, col_all)),
aes(x = x, y = y, label = lab),
size = 3.8, fontface = "bold", color = col
) +
# (7) Dotted ellipses to suggest many nodes (between X3..Xn, Y3..Ym)
annotate("text", x = 0, y = mean(y_inputs[3:(n_inputs-1)]), label = "⋯", size = 6, color = col_all) +
annotate("text", x = 1, y = mean(y_outputs[3:(n_outputs-1)]), label = "⋯", size = 6, color = col_all) +
# (8) Edge labels for highlighted connections
geom_text(
data = w_labs,
aes(x = xm, y = ym, label = lab),
parse = TRUE, size = 4, vjust = -0.3
) +
# Canvas / theme
coord_cartesian(xlim = c(-0.2, 1.2), ylim = c(-0.05, 1.05), expand = FALSE) +
theme_void() +
theme(
plot.margin = margin(10, 10, 10, 10)
)
