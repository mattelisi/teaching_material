mean_val <- exp(mu + 0.5 * sigma_log)
# Create data frame for plotting
df <- data.frame(x = x_vals, y = density_vals)
# Plot
ggplot(df, aes(x, y)) +
geom_area(fill = "purple4", alpha = 0.9) +
geom_segment(aes(x = mean_val, xend = mean_val, y = max(density_vals)*0.9, yend = 0),
arrow = arrow(type = "closed", length = unit(0.2, "cm")),
color = "black", size = 1) +
theme_void() +
theme(panel.background = element_rect(fill = "white", color = NA))
exp(mu + 0.5 * sigma_log)
